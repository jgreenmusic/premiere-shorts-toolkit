<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.jgreenmusic.shortstoolkit.captions" ExtensionBundleVersion="1.0.3"
                   ExtensionBundleName="Shorts Toolkit - Captions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.jgreenmusic.shortstoolkit.captions.panel" Version="1.0.3" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.jgreenmusic.shortstoolkit.captions.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <!-- No StartOn: a hidden start-up copy left the docked tab blank in Premiere 26.5.
               Premiere reopens a docked panel by itself. -->
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Shorts Toolkit - Captions</Menu>
          <Geometry>
            <Size><Height>220</Height><Width>300</Width></Size>
            <MinSize><Height>100</Height><Width>200</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
